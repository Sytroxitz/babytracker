# Copy this file as ".env" next to the production docker-compose.yml
# and fill in real values. Generate secrets with: openssl rand -hex 32

# Your GitHub username/org (lowercase) — the GHCR image namespace.
GHCR_OWNER=your-github-user

# Symfony secret (used for CSRF tokens etc.).
APP_SECRET=

# Passphrase for the JWT signing key. The keypair is generated automatically
# on first start. Changing this later requires deleting the jwt_keys volume,
# which logs every user out.
JWT_PASSPHRASE=

# MySQL credentials. Root password is only used by MySQL itself.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
#MYSQL_USER=babytracker
#MYSQL_DATABASE=babytracker

# Port the app is published on; point your HTTPS reverse proxy here.
HTTP_PORT=8080

# Public URL of the app (used when generating absolute URLs, e.g. in CLI/mails).
APP_URL=https://babytracker.example.com
